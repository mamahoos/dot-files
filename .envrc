# ==============================================================================
# .envrc
# ------------------------------------------------------------------------------
# Loaded by direnv on cd into this repo (`direnv allow` once per clone).
# PRE_COMMIT_COLOR=never: pre-commit paints Passed/Skipped with hardcoded
# ANSI backgrounds that clash with the terminal theme.
# Machine-local overrides go in .envrc.local (ignored via `*.local`).
# ==============================================================================

# set -euo pipefail for the rest of this file; a typo'd variable name fails
# loudly instead of exporting garbage. Guard any command that may return
# non-zero with `|| ...`, or direnv aborts the load.
strict_env

# Disable direnv logging
export DIRENV_LOG_FORMAT=""

# Disable pre-commit color
export PRE_COMMIT_COLOR=never

# Machine-local overrides — never committed
source_env_if_exists .envrc.local

# Tools the Makefile invokes directly (pre-commit pulls gitleaks/actionlint
# from its own cache, so those two need no system binary).
# Silent when healthy; one line per missing tool.
for tool in shellcheck shfmt pre-commit; do
  has "$tool" || printf 'direnv: %s missing\n' "$tool" >&2
done
