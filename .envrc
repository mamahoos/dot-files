# ==============================================================================
# .envrc
# ------------------------------------------------------------------------------
# Loaded by direnv on cd into this repo (`direnv allow` once per clone).
# PRE_COMMIT_COLOR=never: pre-commit paints Passed/Skipped with hardcoded
# ANSI backgrounds that clash with the terminal theme.
# ==============================================================================

# Disable direnv logging
export DIRENV_LOG_FORMAT=""

# Disable pre-commit color
export PRE_COMMIT_COLOR=never