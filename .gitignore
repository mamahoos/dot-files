# Local overrides (machine-specific; never commit)
home/.bashrc.local
*.local

# OS / editor junk
.DS_Store

# Tool caches
.cache/

# Secrets
home/.ssh/

# Cursor project dir (repo root only; home/.cursor/ stays versioned)
/.cursor/

# ui-ux-pro-max bytecode (search scripts are versioned)
home/.cursor/skills/ui-ux-pro-max/**/__pycache__/

# Logs
*.log

# TPM / resurrect if they ever land in the linked XDG tree
config/tmux/plugins/
config/tmux/resurrect/

# Graphify — generated output and local-only tooling
graphify-out/
raw/
.graphifyignore
scripts/export-github-corpus.sh
