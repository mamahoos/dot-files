# ============================================================
# Ghostty — mamahoos
# ============================================================

# ------------------------------------------------------------
# Font
# ------------------------------------------------------------

font-family = JetBrains Mono
font-size = 13

# Programming ligatures
font-feature = calt
font-feature = liga

# Completely unhinted FreeType (not just no-hinting while autohint stays on).
freetype-load-flags = no-hinting,no-autohint,no-force-autohint,no-monochrome
alpha-blending = linear-corrected

# Extra air in the cell so glyphs do not feel packed against the cursor.
adjust-cell-height = 10%
adjust-cell-width = 4%

# ------------------------------------------------------------
# Green terminal aesthetic
# ------------------------------------------------------------

background = 020603
foreground = B8E8BC

cursor-color = 7CFF88
cursor-text = 020603

selection-background = 145C25
selection-foreground = E8FFE9

# Black
palette = 0=#020603

# Red
palette = 1=#D65C5C

# Green
palette = 2=#4ED66D

# Yellow
palette = 3=#C9D66A

# Blue
palette = 4=#5C8FD6

# Magenta
palette = 5=#A66AD6

# Cyan
palette = 6=#5CCFCF

# White
palette = 7=#B8E8BC

# Bright black
palette = 8=#28402C

# Bright red
palette = 9=#FF6B6B

# Bright green
palette = 10=#63FF82

# Bright yellow
palette = 11=#E5F56B

# Bright blue
palette = 12=#70A5FF

# Bright magenta
palette = 13=#C17CFF

# Bright cyan
palette = 14=#6FFFE9

# Bright white
palette = 15=#E8FFE9

# ------------------------------------------------------------
# Transparency / glass
# ------------------------------------------------------------

background-opacity = 0.82
background-blur = 30

# ------------------------------------------------------------
# Cursor
# ------------------------------------------------------------
# Community shaders expect Ghostty's native cursor rect (usually block).
# cursor-opacity 0 + a homegrown shader put the bar on the wrong row.

cursor-style = block
cursor-style-blink = true
cursor-opacity = 1
adjust-cursor-height = -28%
adjust-cursor-thickness = -20%

mouse-hide-while-typing = true

# ------------------------------------------------------------
# Window
# ------------------------------------------------------------

window-padding-x = 18
window-padding-y = 16
window-padding-balance = true
window-padding-color = extend

window-theme = ghostty

# GTK 1.3.1 can re-fire resize when the scrollbar appears (ghostty#12161),
# so the cols×rows overlay loops in the middle of the window.
resize-overlay = never

unfocused-split-opacity = 0.72
split-divider-color = 174D25

# ------------------------------------------------------------
# Splits / Navigation
# ------------------------------------------------------------

# Create
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down

# Focus (alt+shift: GNOME already owns ctrl+alt+arrows for workspaces)
keybind = alt+shift+arrow_up=goto_split:up
keybind = alt+shift+arrow_down=goto_split:down
keybind = alt+shift+arrow_left=goto_split:left
keybind = alt+shift+arrow_right=goto_split:right

# Cycle
keybind = super+ctrl+[=goto_split:previous
keybind = super+ctrl+]=goto_split:next

# Resize
keybind = super+ctrl+shift+arrow_up=resize_split:up,10
keybind = super+ctrl+shift+arrow_down=resize_split:down,10
keybind = super+ctrl+shift+arrow_left=resize_split:left,10
keybind = super+ctrl+shift+arrow_right=resize_split:right,10

# Zoom
keybind = ctrl+shift+enter=toggle_split_zoom

# Delete
keybind = ctrl+shift+x=close_surface

# ------------------------------------------------------------
# Shell integration
# ------------------------------------------------------------

shell-integration = bash
# sudo: wrap local `sudo` with --preserve-env=TERMINFO (Ghostty default is no-sudo).
shell-integration-features = ssh-env,ssh-terminfo,title,no-cursor,sudo

# ------------------------------------------------------------
# Performance / rendering
# ------------------------------------------------------------

# GPU path, vsync-aligned where the runtime supports it.
# Do not raise background-blur further: Ghostty 1.3 warns high
# intensity can stutter on Linux compositors (the opposite of smooth).
window-vsync = true

# Sweep (sahaj-b) for larger jumps; Boo (hced) for 1-cell type/backspace.
custom-shader = shaders/cursor_sweep.glsl
custom-shader = shaders/boo-cursor.glsl
custom-shader-animation = always
