{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // Ghostty green + gold fetch, with burnt amber for logo / section marks /
    // frame edges. Compact keys, light L-bracket spine — no boxes, no
    // Nothing-style tracked capitals, no nerd icons.

    "logo": {
        "type": "file",
        // Absolute (~) so CWD does not fall back to the builtin Debian logo.
        "source": "~/.config/fastfetch/debian.txt",
        "color": {
            "1": "#D4893A",
            "2": "#4ED66D"
        },
        "padding": {
            "left": 1,
            "right": 4,
            "top": 0
        }
    },

    "display": {
        "separator": "  ",
        "brightColor": false,
        "key": {
            "width": 12
        },
        "color": {
            "keys": "#D6B85A",
            "title": "#E5C76B",
            "output": "#C5D0C6",
            "separator": "#28402C"
        },
        "percent": {
            "type": ["num", "bar"],
            "color": {
                "green": "#4ED66D",
                "yellow": "#D4893A",
                "red": "#FF6B6B"
            }
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "border": {
                "left": "",
                "right": ""
            },
            "width": 10
        },
        "size": {
            "binaryPrefix": "si"
        }
    },

    "modules": [
        {
            "type": "title",
            "key": " ",
            "format": "\u001b[38;2;212;137;58m┌─\u001b[0m  \u001b[38;2;229;199;107m{user-name}\u001b[0m \u001b[38;2;40;64;44m·\u001b[0m \u001b[38;2;197;208;198m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;107;74;40m│\u001b[0m"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;107;74;40m│\u001b[0m  \u001b[38;2;212;137;58m// SYSTEM\u001b[0m"
        },
        {
            "type": "os",
            "key": "│ OS",
            "format": "{pretty-name} {arch}"
        },
        {
            "type": "host",
            "key": "│ Host",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "│ Kernel",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "│ Uptime"
        },
        {
            "type": "packages",
            "key": "│ Packages"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;107;74;40m│\u001b[0m"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;107;74;40m│\u001b[0m  \u001b[38;2;212;137;58m// HARDWARE\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "│ CPU",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "│ GPU",
            "hideType": "integrated",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "│ Memory",
            "format": "{used} / {total}  {percentage-bar} {percentage}"
        },
        {
            "type": "disk",
            "key": "│ Disk",
            "folders": "/",
            "format": "{size-used} / {size-total}  {size-percentage-bar} {size-percentage}"
        },
        {
            "type": "battery",
            "key": "│ Battery",
            "format": "{capacity} {status}"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;107;74;40m│\u001b[0m"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;107;74;40m│\u001b[0m  \u001b[38;2;212;137;58m// SESSION\u001b[0m"
        },
        {
            "type": "wm",
            "key": "│ WM",
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": "│ Shell",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "terminal",
            "key": "│ Term",
            "format": "{pretty-name}"
        },
        {
            "type": "display",
            "key": "│ Screen",
            "format": "{width}x{height} @ {refresh-rate} Hz"
        },
        {
            "type": "localip",
            "key": "│ Net",
            "showIpv4": true,
            "showIpv6": false,
            "showLoop": false,
            "defaultRouteOnly": true,
            "format": "{ipv4}"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;212;137;58m└─\u001b[0m"
        }
    ]
}
