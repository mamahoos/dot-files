{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // Green + gold Debian fetch: airy section groups, tracked keys,
    // custom swirl logo — no boxes, no nerd icons.

    "logo": {
        "type": "file",
        // Absolute (~) so CWD does not fall back to the builtin Debian logo.
        "source": "~/.config/fastfetch/debian.txt",
        "color": {
            "1": "#D6B85A",
            "2": "#4ED66D"
        },
        "padding": {
            "left": 1,
            "right": 4,
            "top": 1
        }
    },

    "display": {
        "separator": "  ",
        "brightColor": false,
        "key": {
            "width": 17
        },
        "color": {
            "keys": "#D6B85A",
            "title": "#E5C76B",
            "output": "#B8E8BC",
            "separator": "#28402C"
        },
        "percent": {
            "type": ["num", "bar"],
            "color": {
                "green": "#4ED66D",
                "yellow": "#D6B85A",
                "red": "#FF6B6B"
            }
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "border": {
                "left": "",
                "right": ""
            },
            "width": 10
        },
        "size": {
            "binaryPrefix": "si"
        }
    },

    "modules": [
        {
            "type": "title",
            "key": " ",
            "format": "\u001b[38;2;229;199;107m{user-name}\u001b[0m \u001b[38;2;40;64;44mat\u001b[0m \u001b[38;2;184;232;188m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;40;64;44m──────────────────────────────\u001b[0m"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;214;184;90m// SYSTEM\u001b[0m"
        },
        {
            "type": "os",
            "key": "O S",
            "format": "{pretty-name} {arch}"
        },
        {
            "type": "host",
            "key": "H O S T",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "K E R N E L",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "U P T I M E"
        },
        {
            "type": "packages",
            "key": "P A C K A G E S"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;40;64;44m──────────────────────────────\u001b[0m"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;214;184;90m// HARDWARE\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "C P U",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "G P U",
            "hideType": "integrated",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "M E M O R Y",
            "format": "{used} / {total}  {percentage-bar} {percentage}"
        },
        {
            "type": "disk",
            "key": "D I S K",
            "folders": "/",
            "format": "{size-used} / {size-total}  {size-percentage-bar} {size-percentage}"
        },
        {
            "type": "battery",
            "key": "B A T T E R Y",
            "format": "{capacity} {status}"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;40;64;44m──────────────────────────────\u001b[0m"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;214;184;90m// SESSION\u001b[0m"
        },
        {
            "type": "wm",
            "key": "W M",
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": "S H E L L",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "terminal",
            "key": "T E R M",
            "format": "{pretty-name}"
        },
        {
            "type": "display",
            "key": "S C R E E N",
            "format": "{width}x{height} @ {refresh-rate} Hz"
        },
        {
            "type": "localip",
            "key": "N E T",
            "showIpv4": true,
            "showIpv6": false,
            "showLoop": false,
            "defaultRouteOnly": true,
            "format": "{ipv4}"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;40;64;44m└─\u001b[0m"
        }
    ]
}
