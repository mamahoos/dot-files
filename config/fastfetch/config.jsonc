{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // Compact Debian logo keeps the info column readable in narrow panes.
    "logo": {
        "type": "small",
        "source": "debian_small",
        "color": {
            "1": "#4ED66D",
            "2": "#63FF82",
            "3": "#B8E8BC",
            "4": "#5CCFCF",
            "5": "#7CFF88",
            "6": "#E8FFE9",
            "7": "#B8E8BC",
            "8": "#28402C",
            "9": "#FF6B6B"
        },
        "padding": {
            "top": 1,
            "right": 5
        },
        "printRemaining": false
    },

    "display": {
        "separator": "  ",
        "brightColor": true,
        "color": {
            "keys": "#D6B85A",
            "title": "#E5C76B",
            "output": "#63FF82",
            "separator": "#28402C"
        },
        "key": {
            "width": 14,
            "type": "string"
        }
    },

    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "wm",
        "terminal",
        {
            "type": "terminalfont",
            "key": "Font",
            "format": "{name} ({size})"
        },
        "cpu",
        "memory",
        "disk",
        {
            "type": "localip",
            "key": "Network",
            "showIpv4": true,
            "showIpv6": false,
            "showLoop": false,
            "defaultRouteOnly": true,
            "format": "{ipv4}"
        },
        {
            "type": "battery",
            "key": "Battery",
            "format": "{capacity} {status}"
        },
        {
            "type": "break",
            "display": {
                "outputColor": "#28402C"
            }
        },
        "colors"
    ]
}
