# ============================================================
# Bash Prompt — server
# ============================================================
# Long-lived branch for shared / remote hosts (VPS, work, friends,
# root shells). Shows user@host. Laptop profile stays on main.
# Colors aligned with Ghostty green + gold.
# ============================================================

# Reset
_RESET='\[\e[0m\]'

# Colors (256-color)
_GREEN='\[\e[38;5;114m\]'
_BRIGHT_GREEN='\[\e[38;5;120m\]'
_DIM_GREEN='\[\e[38;5;71m\]'
_GOLD='\[\e[38;5;179m\]'
_DIM='\[\e[38;5;245m\]'

# user@host path ❯
PS1="${_GREEN}\u${_DIM}@${_GOLD}\h ${_DIM_GREEN}\w${_RESET} ${_BRIGHT_GREEN}❯${_RESET} "
