# ============================================================
# Bash Prompt — VPS / pacman
# ============================================================
# vps branch: show user@host. Laptop main keeps user + cwd only.
# Colors aligned with Ghostty green + gold.
# ============================================================

# Reset
_RESET='\[\e[0m\]'

# Colors (256-color)
_GREEN='\[\e[38;5;114m\]'
_BRIGHT_GREEN='\[\e[38;5;120m\]'
_DIM_GREEN='\[\e[38;5;71m\]'
_GOLD='\[\e[38;5;179m\]'
_DIM='\[\e[38;5;245m\]'

# user@host path ❯
PS1="${_GREEN}\u${_DIM}@${_GOLD}\h ${_DIM_GREEN}\w${_RESET} ${_BRIGHT_GREEN}❯${_RESET} "
