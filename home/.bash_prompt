# ============================================================
# Bash Prompt
# ============================================================
# Sourced from ~/.bashrc. Rebuilds PS1 each prompt via PROMPT_COMMAND.
# Readline owns vim-mode (`N` in ~/.inputrc). Later slices: SSH host.
# This slice: adaptive paths (pluggable strategies), red ❯ on failure,
# * for dirty worktrees, operation markers, and ↑/↓ vs upstream.
# ============================================================

# Reset
_RESET='\[\e[0m\]'

# Colors (256-color). Kept even if unused yet — later segments reuse them.
_GREEN='\[\e[38;5;114m\]'
_BRIGHT_GREEN='\[\e[38;5;120m\]'
_DIM_GREEN='\[\e[38;5;71m\]'
_GOLD='\[\e[38;5;179m\]'
_RED='\[\e[38;5;203m\]'
_WHITE='\[\e[38;5;252m\]'
_DIM='\[\e[38;5;245m\]'

# Keep virtualenv from prepending its own `(.venv)` segment to PS1.
export VIRTUAL_ENV_DISABLE_PROMPT=1

# Server overlays can enable the host segment without replacing this prompt.
PROMPT_SHOW_HOST="${PROMPT_SHOW_HOST:-0}"

# Workspace root rendered as ./project[/…]. Override to retarget.
_PROMPT_PATH_PERSONAL_ROOT="${HOME}/dev/personal"

# --- Path strategies (first match wins) --------------------------------------
# Each strategy prints a display path and returns 0 on match, else 1.
# Return via stdout only — callers capture with $(…) and test $?.

# ~/dev/personal → ~/dev/personal ; children → ./project[/subpath]
_prompt_path_strategy_personal() {
    local path="$1"
    local root="${_PROMPT_PATH_PERSONAL_ROOT}"

    if [[ "$path" == "$root" ]]; then
        if [[ "$root" == "$HOME" ]]; then
            printf '~'
        elif [[ "$root" == "$HOME/"* ]]; then
            printf '~/%s' "${root#"$HOME"/}"
        else
            printf '%s' "$root"
        fi
        return 0
    fi
    if [[ "$path" == "$root/"* ]]; then
        printf './%s' "${path#"$root"/}"
        return 0
    fi
    return 1
}

# $HOME → ~ ; $HOME/… → ~/…
_prompt_path_strategy_home() {
    local path="$1"

    if [[ "$path" == "$HOME" ]]; then
        printf '~'
        return 0
    fi
    if [[ "$path" == "$HOME/"* ]]; then
        printf '~/%s' "${path#"$HOME"/}"
        return 0
    fi
    return 1
}

# --- Path shrinkers ----------------------------------------------------------

# ~/a/b/leaf → ~/a/b/leaf with parent segments collapsed to one char.
_prompt_path_shrink_initials() {
    local display_path="$1"
    local basename="${display_path##*/}"
    local prefix="${display_path%/*}"
    local shortened='~'
    local component
    local -a components

    prefix="${prefix#'~/'}"
    IFS='/' read -r -a components <<< "$prefix"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || continue
        shortened+="/${component:0:1}"
    done
    shortened+="/${basename}"
    printf '%s' "$shortened"
}

# any/long/path → …/parent/basename
_prompt_path_shrink_tail() {
    local display_path="$1"
    local basename="${display_path##*/}"
    local prefix="${display_path%/*}"

    printf '…/%s/%s' "${prefix##*/}" "$basename"
}

# Ordered registry: "strategy_fn:shrink_policy".
# shrink_policy: initials (then tail) | tail.
# Append another root/alias by adding a strategy fn + one entry here.
_PROMPT_PATH_STRATEGIES=(
    '_prompt_path_strategy_personal:tail'
    '_prompt_path_strategy_home:initials'
)

# Resolve via strategies, then shrink to max_length.
_prompt_path() {
    local path="$PWD"
    local max_length="${1:-30}"
    local display_path=''
    local shrink='tail'
    local shortened
    local entry
    local strategy
    local matched=false

    for entry in "${_PROMPT_PATH_STRATEGIES[@]}"; do
        strategy="${entry%%:*}"
        if display_path=$("$strategy" "$path"); then
            shrink="${entry##*:}"
            matched=true
            break
        fi
    done
    if [[ "$matched" != true ]]; then
        display_path="$path"
        shrink='tail'
    fi

    if ((${#display_path} <= max_length)); then
        printf '%s' "$display_path"
        return
    fi

    if [[ "$shrink" == 'initials' ]]; then
        shortened=$(_prompt_path_shrink_initials "$display_path")
        if ((${#shortened} <= max_length)); then
            printf '%s' "$shortened"
            return
        fi
    fi

    _prompt_path_shrink_tail "$display_path"
}

_prompt_git_branch() {
    local branch

    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || return 0
    printf '%s' "$branch"
}

_prompt_git_status() {
    local index_status
    local worktree_status
    local staged=0
    local unstaged=0
    local untracked=0
    local segment=''

    while IFS= read -r status_line; do
        [[ -n "$status_line" ]] || continue
        index_status="${status_line:0:1}"
        worktree_status="${status_line:1:1}"

        if [[ "$index_status" == '?' && "$worktree_status" == '?' ]]; then
            ((untracked += 1))
            continue
        fi
        [[ "$index_status" == ' ' ]] || ((staged += 1))
        [[ "$worktree_status" == ' ' ]] || ((unstaged += 1))
    done < <(git status --porcelain=v1 --untracked-files=normal 2>/dev/null)

    if ((staged > 0)); then
        segment+=" +${staged}"
    fi
    if ((unstaged > 0)); then
        segment+=" ~${unstaged}"
    fi
    if ((untracked > 0)); then
        segment+=" ?${untracked}"
    fi

    printf '%s' "$segment"
}

_prompt_git_operation() {
    local git_dir

    git_dir=$(git rev-parse --git-dir 2>/dev/null) || return 0
    if [[ -f "$git_dir/MERGE_HEAD" ]]; then
        printf '⇄'
    elif [[ -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" ]]; then
        printf '↻'
    elif [[ -f "$git_dir/CHERRY_PICK_HEAD" ]]; then
        printf '✚'
    elif [[ -f "$git_dir/REVERT_HEAD" ]]; then
        printf '↩'
    fi
}

_prompt_git_ahead_behind() {
    local counts
    local ahead
    local behind
    local segment=''

    counts=$(git rev-list --left-right --count 'HEAD...@{upstream}' 2>/dev/null) || return 0
    ahead="${counts%%	*}"
    behind="${counts##*	}"

    if ((ahead > 0)); then
        segment+="↑${ahead}"
    fi
    if ((behind > 0)); then
        [[ -n "$segment" ]] && segment+=' '
        segment+="↓${behind}"
    fi

    printf '%s' "$segment"
}

_prompt_virtualenv() {
    local environment

    [[ -n "${VIRTUAL_ENV:-}" ]] || return 0
    environment="${VIRTUAL_ENV##*/}"
    printf '[%s]' "$environment"
}

_prompt_command_start() {
    case "${FUNCNAME[1]:-}" in
        _prompt_*|__ghostty_hook*)
            return
            ;;
    esac

    case "$BASH_COMMAND" in
        _prompt_build*|_prompt_command_start*|__ghostty_hook*|_PROMPT_COMMAND_START=*)
            return
            ;;
    esac

    _PROMPT_COMMAND_START=$SECONDS
}

_PROMPT_COMMAND_START=-1
trap '_prompt_command_start' DEBUG

# Snapshot $? first, then restore it so later PROMPT_COMMAND hooks
# (Ghostty __ghostty_hook) still see the command status.
_prompt_build() {
    local last_status=$?
    local chevron_color="${_BRIGHT_GREEN}"
    local git_branch
    local git_status
    local git_operation
    local git_ahead_behind
    local git_segment=''
    local prompt_identity="${_GREEN}\u "
    local virtualenv
    local virtualenv_segment=''
    local prompt_path
    local path_limit=30
    local command_duration=0
    local duration_segment=''

    if ((last_status != 0)); then
        chevron_color="${_RED}"
    fi

    git_branch="$(_prompt_git_branch)"
    git_operation="$(_prompt_git_operation)"
    if ((${#git_branch} > 20)); then
        path_limit=20
    fi
    prompt_path="$(_prompt_path "$path_limit")"
    virtualenv="$(_prompt_virtualenv)"
    if [[ -n "$virtualenv" ]]; then
        virtualenv_segment=" ${_DIM}${virtualenv}${_RESET}"
    fi
    if ((_PROMPT_COMMAND_START >= 0)); then
        command_duration=$((SECONDS - _PROMPT_COMMAND_START))
        _PROMPT_COMMAND_START=-1
    fi
    if ((command_duration >= 1)); then
        duration_segment=" ${_DIM}${command_duration}s${_RESET}"
    fi
    if [[ -n "$git_branch" ]]; then
        git_status="$(_prompt_git_status)"
        git_ahead_behind="$(_prompt_git_ahead_behind)"
        git_segment=" ${_GOLD}${git_branch}${_RESET}"
        if [[ -n "$git_status" ]]; then
            git_segment+=" ${_RED}${git_status}${_RESET}"
        fi
        if [[ -n "$git_ahead_behind" ]]; then
            git_segment+=" ${_DIM}${git_ahead_behind}${_RESET}"
        fi
    fi
    if [[ -n "$git_operation" ]]; then
        git_segment+=" ${_RED}${git_operation}${_RESET}"
    fi

    if [[ "$PROMPT_SHOW_HOST" == 1 ]]; then
        prompt_identity="${_GREEN}\u${_GOLD}@\h "
    fi

    # \u and \h expand when bash draws the prompt.
    PS1="${prompt_identity}${_DIM_GREEN}${prompt_path}${_RESET}${virtualenv_segment}${git_segment}${duration_segment} ${chevron_color}❯${_RESET} "

    return "${last_status}"
}

# Prepend so we snapshot $? before other hooks. Idempotent on re-source.
if [[ ";${PROMPT_COMMAND[*]:-};" != *";_prompt_build;"* ]]; then
    if [[ -z "${PROMPT_COMMAND[*]:-}" ]]; then
        if ((BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 1))); then
            PROMPT_COMMAND=(_prompt_build)
        else
            PROMPT_COMMAND=_prompt_build
        fi
    elif [[ $(builtin declare -p PROMPT_COMMAND 2>/dev/null) == "declare -a "* ]]; then
        PROMPT_COMMAND=(_prompt_build "${PROMPT_COMMAND[@]}")
    else
        PROMPT_COMMAND="_prompt_build; ${PROMPT_COMMAND}"
    fi
fi
