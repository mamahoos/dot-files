# Readline for bash(1). Complements ~/.bashrc; keep Debian keybindings.

# ======================================================================
# Debian base
# ======================================================================
$include /etc/inputrc

# ======================================================================
# UTF-8
# ======================================================================
# Persian aliases in ~/.bash_aliases need 8-bit characters intact.
set input-meta   on
set output-meta  on
set convert-meta off

# ======================================================================
# Editing
# ======================================================================
# /etc/inputrc emacs Home/End bindings do not apply in vi mode.
set editing-mode       vi
set show-mode-in-prompt on

$if mode=vi
set keymap vi-command
"k": history-search-backward
"j": history-search-forward
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[3~": delete-char

set keymap vi-insert
"\C-w": backward-kill-word
"\e[A": history-search-backward
"\e[B": history-search-forward
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[3~": delete-char
"\e[1;5C": forward-word
"\e[1;5D": backward-word
$endif

# ======================================================================
# History
# ======================================================================
# history-size matches ~/.bashrc HISTSIZE (overrides HISTSIZE when set).
set history-size 5000

# ======================================================================
# Completion
# ======================================================================
# Complements shopt: progcomp, complete_fullquote, dotglob.
# Colors follow dircolors / color_prompt in ~/.bashrc.
set completion-ignore-case     on
set match-hidden-files         on
set skip-completed-text        on
set colored-stats              on
set colored-completion-prefix  on
set visible-stats              on
set mark-symlinked-directories on
set show-all-if-ambiguous      on

# ======================================================================
# Paste
# ======================================================================
set enable-bracketed-paste on
