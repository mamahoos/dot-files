
# ==============================================================================
# FZF CONFIGURATION — Ghostty Green Theme
# ==============================================================================

# ------------------------------------------------------------------------------
# Global options
# ------------------------------------------------------------------------------

export FZF_DEFAULT_OPTS='
--no-mouse
--height=50%
--select-1
--reverse
--multi
--info=inline
--border=rounded
--padding=0,1

--color=fg:#B8E8BC,bg:-1,fg+:#E8FFE9,bg+:#145C25,hl:#4ED66D,hl+:#7CFF88,border:#28402C,info:#4ED66D,prompt:#7CFF88,pointer:#63FF82,marker:#C9D66A,spinner:#63FF82,header:#5CCFCF

--preview="if file --mime-encoding -b -- {} | grep -qx binary; then file -- {}; else batcat --style=numbers --color=always -- {}; fi 2>/dev/null | head -300"
--preview-window=right:50%:wrap

--bind="f2:toggle-preview"
--bind="f3:change-preview-window(right,50%,border-left|right,70%,border-left|down,70%,border-top)"
--bind="f4:change-preview-window(down,90%,border-top|right,50%,border-left)"

--bind="ctrl-d:half-page-down"
--bind="ctrl-u:half-page-up"
--bind="ctrl-a:select-all+accept"
--bind="ctrl-y:execute-silent(echo {+} | xclip -selection clipboard)"
'

# ------------------------------------------------------------------------------
# Remove old Ctrl+T / Ctrl+X widgets from Readline
# ------------------------------------------------------------------------------

if [[ $- == *i* ]]; then
    bind -r '\C-t' 2>/dev/null
    bind -r '\C-x\C-t' 2>/dev/null
fi

# ==============================================================================
# END OF FZF CONFIGURATION
# ==============================================================================

